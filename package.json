{
  "name": "blank-to-null",
  "version": "1.1.1",
  "description": "Turn blank and undefined values into null, deeply, with zero dependencies.",
  "author": "gitsult4n (https://github.com/gitsult4n)",
  "sideEffects": false,
  "main": "./src/index.cjs",
  "types": "./src/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.mts",
        "default": "./src/index.mjs"
      },
      "require": {
        "types": "./src/index.d.cts",
        "default": "./src/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test"
  },
  "keywords": [
    "null",
    "empty",
    "blank",
    "trim",
    "form",
    "dto",
    "sanitize",
    "zero-dependency",
    "esm",
    "commonjs",
    "typescript",
    "undefined"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitsult4n/blank-to-null.git"
  },
  "bugs": {
    "url": "https://github.com/gitsult4n/blank-to-null/issues"
  },
  "homepage": "https://github.com/gitsult4n/blank-to-null#readme",
  "license": "MIT"
}
