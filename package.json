{
  "name": "blank-to-null",
  "version": "1.1.3",
  "description": "Turn blank and undefined values into null, deeply, with zero dependencies.",
  "author": "gitsult4n (https://github.com/gitsult4n)",
  "sideEffects": false,
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./src/index.d.mts",
        "default": "./src/index.mjs"
      },
      "require": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      },
      "default": {
        "types": "./src/index.d.ts",
        "default": "./src/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test",
    "test:types": "node test-d/gen-cts.mjs && tsc -p test-d/tsconfig.json",
    "test:package": "attw --pack .",
    "test:all": "npm run test && npm run test:types && npm run test:package"
  },
  "keywords": [
    "null",
    "empty",
    "blank",
    "trim",
    "form",
    "dto",
    "sanitize",
    "zero-dependency",
    "esm",
    "commonjs",
    "typescript",
    "undefined"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gitsult4n/blank-to-null.git"
  },
  "bugs": {
    "url": "https://github.com/gitsult4n/blank-to-null/issues"
  },
  "homepage": "https://github.com/gitsult4n/blank-to-null#readme",
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "typescript": "^7.0.2"
  }
}
